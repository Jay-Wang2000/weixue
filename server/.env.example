# Copy to .env (gitignored, chmod 600) and fill in.
# IPv4 address of this host on the home LAN (one of its interface addresses); the device's OTA_URL points at it.
LAN_IP=192.168.1.10
# Host address the OTA (8003) and WebSocket (8000) ports bind to; on macOS use 0.0.0.0 (docs/server.md, Network boundary).
BIND_IP=0.0.0.0
# IANA zone; required: the device follows its daylight saving time via server_time.tz.
TZ=Europe/Dublin
# UTC offset in hours for TZ; the device uses it only when the OTA response has no server_time.tz.
TZ_OFFSET=1
LLM_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_SA_FILE=/path/to/google-service-account.json
# Device-Ids (lower-case MACs, comma-separated) admitted by OTA and WebSocket (docs/server.md, Network boundary).
ALLOWED_DEVICES=7c:0c:5f:42:4b:fc
# ha-mcp secret-path URL (the URL is the credential; see docs/ha-mcp.md).
HA_MCP_URL=http://<ha-host>:9584/private_<secret>
# Bearer token for the proactive webhook (docs/proactive.md); empty disables it. Generate with: openssl rand -hex 32
WEIXUE_PROACTIVE_TOKEN=
# Voice LLM path (docs/server.md): anthropic = xiaozhi's own loop (AnthropicLLM + mcp-bridge voice tools),
# claude_agent = every turn goes to agent-service.
VOICE_LLM=anthropic
# 1: speech while a reply plays interrupts it (barge-in); 0 (default): that speech is dropped (docs/server.md, Barge-in).
VOICE_BARGE_IN=0
# Bearer token of agent-service (docs/agent-service.md); setup.sh generates it when unset.
# AGENT_SERVICE_TOKEN=
# agent-monitor's read scope on agent-service and the gateway (docs/agent-monitor.md); setup.sh generates it when unset.
# MONITOR_TOKEN=
# The only credential the monitor board accepts (?token= or bearer); at least 32 characters, different from every
# other token; setup.sh generates it when unset. Unset, the board answers 401 unless MONITOR_BIND is 127.0.0.1.
# MONITOR_VIEW_TOKEN=
# agent-service ha-mcp ping period and timeout in seconds (decision 49); the monitor's ha-mcp tile follows the period.
# AGENT_HA_PROBE_S=10
# AGENT_HA_PROBE_TIMEOUT_S=5
# Home snapshot job of agent-service (decision 48): period in seconds (0 turns it off) and an optional comma-separated
# entity list (at most 20) that replaces the default selection of lock, climate, cover and light entities.
# AGENT_HOME_SNAPSHOT_S=300
# AGENT_HOME_ENTITIES=
# agent-service ha-mcp tool-call read timeout in seconds (default 35); it must outlast the ha-mcp policy wait_seconds,
# or a held call ends unknown before its approval token arrives (docs/agent-service.md).
# HA_MCP_READ_TIMEOUT_S=35
# 0 hides the monitor's home tile (default 1).
# MONITOR_HOME=1
# Host address the monitor's port 8020 binds (default 127.0.0.1). On the Ubuntu server: its LAN address, so the
# Home Assistant dashboard can embed the board (decision 79); the page and /api then need ?token=<MONITOR_VIEW_TOKEN>.
# MONITOR_BIND=192.168.8.125
# Origins allowed to frame the monitor (CSP frame-ancestors; default 'none'). On the server: the HA origin.
# MONITOR_FRAME_ANCESTORS=http://192.168.8.142:8123
# Remote mode, on the device/test host only (docs/server.md, Deployment host): the stack runs on this SSH target and
# scripts/ run docker there; setup.sh refuses to deploy while it is set. Extra ssh options and the server/ checkout there.
# WEIXUE_SERVER_SSH=jay@192.168.8.125
# WEIXUE_SERVER_SSH_OPTS="-o IdentitiesOnly=yes -i ~/.ssh/id_ed25519"
# WEIXUE_SERVER_DIR=weixue/server
# Directory containing the xiaozhi-esp32-server clone pinned in vendor.lock.
# WEIXUE_VENDOR=$HOME/Projects/weixue-vendor
UPSTREAM_MCP_ENDPOINT_IMAGE=ghcr.io/xinnan-tech/mcp-endpoint-server:latest@sha256:33ca12e06dcafb965fb27ecf2631070a267451331b65f0cb0e0332247b0491cc
# Console profile only:
UPSTREAM_WEB_IMAGE=ghcr.io/xinnan-tech/xiaozhi-esp32-server:web_latest@sha256:d5dca8a463a2ce9dbbd9a831787eec843774278c58755c365dadcfef4f6d376c
MYSQL_IMAGE=mysql:8@sha256:6ea90827b1100f8f2ae306a539f86d2c264a26ed435a2a9f75551dd5c3aeb242
REDIS_IMAGE=redis:8.0@sha256:ae471bdc20de180beed36e347d170ec0bdf8faa327959ea1f24692f22b05b955
MYSQL_ROOT_PASSWORD=
# Speech-to-text provider: GoogleSTT (chirp_3 batch, default) or GoogleSTTStream (latest_short streaming).
VOICE_ASR=GoogleSTT
# 1: every ASR segment is written to data/captures/ (16 kHz WAV + JSON sidecar, newest 500 kept) for scripts/stt_replay.py.
WEIXUE_STT_CAPTURE=0
