+    if (threshold > 0.0f) {
+        int ret = afe_iface_->set_wakenet_threshold(afe_data_, 1, threshold);
+        ESP_LOGI(TAG, "WakeNet threshold %.4f (%s)", threshold, ret == 1 ? "set" : "failed");
+    } else if (weixue_audio_tune::wakenet_threshold_dirty.load()) {
+        int ret = afe_iface_->reset_wakenet_threshold(afe_data_, 1);
+        ESP_LOGI(TAG, "WakeNet threshold model default (%s)", ret == 1 ? "reset" : "failed");
+    }
+    weixue_audio_tune::wakenet_threshold_dirty.store(false);
