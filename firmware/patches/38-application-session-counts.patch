+// Every idle -> connecting transition goes through here and logs what started the session.
+bool Application::BeginConnecting(const char* reason) {
+    ESP_LOGI(TAG, "Session start: %s", reason);
+    return SetDeviceState(kDeviceStateConnecting);
+}
+
+bool Application::SendChannelAudio(std::unique_ptr<AudioStreamPacket> packet) {
+    if (packet->encoded_us > 0) {
+        int64_t age = esp_timer_get_time() - packet->encoded_us;
+        if (age > channel_packet_max_age_us_) {
+            channel_packet_max_age_us_ = age;
+        }
+    }
+    if (!protocol_->SendAudio(std::move(packet))) {
+        channel_packets_dropped_++;
+        return false;
+    }
+    channel_packets_sent_++;
+    return true;
+}
