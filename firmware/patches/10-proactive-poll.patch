+// Polls only while idle; on 200 opens a session whose wake text asks the server to deliver.
+void Application::StartProactivePoller(const std::string& ota_url) {
+    if (proactive_task_handle_ != nullptr) {
+        return;
+    }
+    auto scheme = ota_url.find("://");
+    if (scheme == std::string::npos) {
+        ESP_LOGW(TAG, "Proactive poller disabled: invalid OTA URL");
+        return;
+    }
+    proactive_poll_url_ = ota_url.substr(0, ota_url.find('/', scheme + 3)) + kProactivePollPath;
+    ESP_LOGI(TAG, "Proactive poller: %s", proactive_poll_url_.c_str());
+    xTaskCreate(
+        [](void* arg) {
+            static_cast<Application*>(arg)->ProactivePollTask();
+            vTaskDelete(NULL);
+        },
+        "proactive", 4096 * 2, this, 2, &proactive_task_handle_);
 }
 
+void Application::ProactivePollTask() {
+    int retry_ms = kProactiveRetryMinMs;
+    while (true) {
+        if (GetDeviceState() != kDeviceStateIdle) {
+            vTaskDelay(pdMS_TO_TICKS(1000));
+            continue;
+        }
+        int status = 0;
+        auto http = Board::GetInstance().GetNetwork()->CreateHttp(0);
+        http->SetTimeout(kProactivePollTimeoutMs);
+        http->SetHeader("Device-Id", SystemInfo::GetMacAddress());
+        if (http->Open("GET", proactive_poll_url_)) {
+            auto code = http->GetStatusCode();
+            if (code) {
+                status = *code;
+                http->ReadAll();
+            }
+            http->Close();
+        }
+        if (status == 200) {
+            retry_ms = kProactiveRetryMinMs;
+            ESP_LOGI(TAG, "Proactive message pending");
+            Schedule([this]() { ProactiveInvoke(); });
+            vTaskDelay(pdMS_TO_TICKS(2000));
+        } else if (status == 204) {
+            retry_ms = kProactiveRetryMinMs;
+            vTaskDelay(pdMS_TO_TICKS(1000));
+        } else {
+            ESP_LOGW(TAG, "Proactive poll failed (status %d), retry in %d ms", status, retry_ms);
+            vTaskDelay(pdMS_TO_TICKS(retry_ms));
+            retry_ms = std::min(retry_ms * 2, kProactiveRetryMaxMs);
+        }
+    }
+}
+
+void Application::ProactiveInvoke() {
+    if (!protocol_ || GetDeviceState() != kDeviceStateIdle ||
+        !SetDeviceState(kDeviceStateConnecting)) {
+        return;
+    }
+    Schedule([this]() {
+        if (GetDeviceState() != kDeviceStateConnecting) {
+            return;
+        }
+        Board::GetInstance().SetPowerSaveLevel(PowerSaveLevel::PERFORMANCE);
+        if (!protocol_->IsAudioChannelOpened() && !protocol_->OpenAudioChannel()) {
+            SetDeviceState(kDeviceStateIdle);
+            return;
+        }
+        ESP_LOGI(TAG, "Proactive session opened");
+        protocol_->SendWakeWordDetected(kProactiveWakeText);
+        SetListeningMode(GetDefaultListeningMode());
+    });
+}
