+static constexpr int64_t kOutputLevelHoldUs = 150 * 1000;
+
+void AudioService::UpdateOutputLevel(const std::vector<int16_t>& pcm) {
+    if (pcm.empty()) {
+        return;
+    }
+    double sum = 0;
+    for (int16_t v : pcm) {
+        sum += static_cast<double>(v) * v;
+    }
+    double rms = std::sqrt(sum / pcm.size()) / 32768.0;
+    double db = rms > 0 ? 20.0 * std::log10(rms) : -100.0;
+    double level = std::clamp((db + 50.0) / 44.0, 0.0, 1.0);
+    output_level_ = static_cast<uint8_t>(level * 255.0 + 0.5);
+    output_level_us_ = esp_timer_get_time();
+}
+
+uint8_t AudioService::GetOutputLevel() const {
+    if (esp_timer_get_time() - output_level_us_.load() > kOutputLevelHoldUs) {
+        return 0;
+    }
+    return output_level_;
+}
