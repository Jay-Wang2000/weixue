+    void InitializeImu() {
+        imu_ = Qmi8658::Probe(i2c_bus_);
+        if (imu_ == nullptr) {
+            return;
+        }
+        if (imu_->Initialize() != ESP_OK) {
+            delete imu_;
+            imu_ = nullptr;
+            return;
+        }
+        xTaskCreate([](void* arg) { static_cast<WaveshareEsp32s3TouchAMOLED1inch75*>(arg)->ImuTask(); },
+                    "imu", 4096, this, 2, nullptr);
+    }
+
+    void ImuTask() {
+        ImuGestureDetector detector;
+        TickType_t last_wake = xTaskGetTickCount();
+        uint32_t errors = 0;
+        bool logged_first_sample = false;
+        while (true) {
+            vTaskDelayUntil(&last_wake, pdMS_TO_TICKS(ImuGestureDetector::kSamplePeriodMs));
+            Qmi8658::Accel accel;
+            Qmi8658::TapStatus tap;
+            if (imu_->ReadAccel(accel) != ESP_OK || imu_->ReadTap(tap) != ESP_OK) {
+                if (errors++ % 500 == 0) {
+                    ESP_LOGW(TAG, "IMU read failed (%lu)", (unsigned long)errors);
+                }
+                continue;
+            }
+            if (!logged_first_sample) {
+                logged_first_sample = true;
+                ESP_LOGI(TAG, "IMU accel x=%.3f y=%.3f z=%.3f g", accel.x, accel.y, accel.z);
+            }
+            {
+                std::lock_guard<std::mutex> lock(gesture_mutex_);
+                last_accel_ = accel;
+            }
+            if (tap.status1 & 0x02) {
+                ESP_LOGI(TAG, "IMU tap: status1=0x%02X tap_status=0x%02X", tap.status1, tap.tap_status);
+                if (tap.count() == 2) {
+                    OnGesture(kGestureDoubleTap);
+                }
+            }
+            uint8_t events = detector.Update(accel.x, accel.y, kScreenNormalSign * accel.z);
+            if (events & ImuGestureDetector::kPickUp) {
+                OnGesture(kGesturePickUp);
+            }
+            if (events & ImuGestureDetector::kFaceDown) {
+                OnGesture(kGestureFaceDown);
+            }
+            if (events & ImuGestureDetector::kFaceUp) {
+                OnGesture(kGestureFaceUp);
+            }
+        }
+    }
+
+    void OnGesture(Gesture gesture) {
+        bool face_down;
+        {
+            std::lock_guard<std::mutex> lock(gesture_mutex_);
+            gesture_counts_[gesture]++;
+            last_gesture_ = gesture;
+            last_gesture_us_ = esp_timer_get_time();
+            if (gesture == kGestureFaceDown || gesture == kGestureFaceUp) {
+                face_down_ = gesture == kGestureFaceDown;
+            }
+            face_down = face_down_;
+            ESP_LOGI(TAG, "IMU gesture: %s (count %lu)", kGestureNames[gesture],
+                     (unsigned long)gesture_counts_[gesture]);
+        }
+
+        auto& app = Application::GetInstance();
+        app.Schedule([this, gesture, &app]() {
+            switch (gesture) {
+                case kGesturePickUp:
+                    WakeDisplay();
+                    break;
+                case kGestureFaceDown:
+                case kGestureFaceUp: {
+                    bool mute = gesture == kGestureFaceDown;
+                    if (!mute) {
+                        WakeDisplay();
+                    }
+                    app.SetMicMuted(mute);
+                    display_->SetMicMuted(mute);
+                    display_->ShowNotification(mute ? "Muted" : "Unmuted");
+                    break;
+                }
+                case kGestureDoubleTap: {
+                    auto state = app.GetDeviceState();
+                    if (state == kDeviceStateSpeaking) {
+                        app.AbortSpeaking(kAbortReasonNone);
+                    } else if (state == kDeviceStateNotifying) {
+                        app.StopListening();
+                    }
+                    break;
+                }
+                default:
+                    break;
+            }
+        });
+        app.SendMcpMessage(std::string("{\"jsonrpc\":\"2.0\",\"method\":\"notifications/weixue/imu\","
+                                       "\"params\":{\"gesture\":\"") +
+                           kGestureNames[gesture] + "\",\"face_down\":" +
+                           (face_down ? "true" : "false") + "}}");
+    }
+
+    std::string GetImuStateJson() {
+        std::lock_guard<std::mutex> lock(gesture_mutex_);
+        char buf[320];
+        int64_t age_ms = last_gesture_ < 0 ? -1 : (esp_timer_get_time() - last_gesture_us_) / 1000;
+        snprintf(buf, sizeof(buf),
+                 "{\"face_down\":%s,\"mic_muted\":%s,\"last_gesture\":\"%s\",\"last_gesture_age_ms\":%lld,"
+                 "\"counts\":{\"pick_up\":%lu,\"face_down\":%lu,\"face_up\":%lu,\"double_tap\":%lu},"
+                 "\"accel_g\":[%.2f,%.2f,%.2f]}",
+                 face_down_ ? "true" : "false",
+                 Application::GetInstance().IsMicMuted() ? "true" : "false",
+                 last_gesture_ < 0 ? "" : kGestureNames[last_gesture_], (long long)age_ms,
+                 (unsigned long)gesture_counts_[kGesturePickUp],
+                 (unsigned long)gesture_counts_[kGestureFaceDown],
+                 (unsigned long)gesture_counts_[kGestureFaceUp],
+                 (unsigned long)gesture_counts_[kGestureDoubleTap], last_accel_.x, last_accel_.y,
+                 last_accel_.z);
+        return buf;
+    }
