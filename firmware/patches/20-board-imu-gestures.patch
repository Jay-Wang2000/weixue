+    enum Gesture { kGesturePickUp, kGestureFaceDown, kGestureFaceUp, kGestureDoubleTap, kGestureCount };
+    static constexpr const char* kGestureNames[kGestureCount] = {"pick_up", "face_down", "face_up",
