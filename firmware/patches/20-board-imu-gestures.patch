+        const char* glyph =
+            mic_muted_ ? MATERIAL_SYMBOLS_MIC_OFF : (muted_ ? MATERIAL_SYMBOLS_VOLUME_OFF : "");
+        if (strcmp(lv_label_get_text(mute_label_), glyph) != 0) {
+            lv_label_set_text(mute_label_, glyph);
+        }
