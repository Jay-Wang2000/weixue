+    // Sign that maps the QMI8658 z axis to the screen normal (+z out of the screen).
+    static constexpr float kScreenNormalSign = 1.0f;
+
+    std::mutex gesture_mutex_;
+    uint32_t gesture_counts_[kGestureCount] = {};
