+// Delivers one device event over its own short WebSocket session, so a slow or unreachable
+// server never blocks the main task or raises the network error alert.
+void Application::DeviceEventWorker(std::shared_ptr<DeviceEventJob> job) {
+    constexpr EventBits_t kHelloBit = BIT0;
+    const char* result = "connect failed";
+    bool sent = false;
+    EventGroupHandle_t events = xEventGroupCreate();
+    std::string session_id;
+    auto ws = Board::GetInstance().GetNetwork()->CreateWebSocket(2);
+    if (ws && events) {
+        if (!job->token.empty()) {
+            std::string token = job->token;
+            if (token.find(' ') == std::string::npos) {
+                token = "Bearer " + token;
+            }
+            ws->SetHeader("Authorization", token.c_str());
+        }
+        ws->SetHeader("Protocol-Version", std::to_string(job->version).c_str());
+        ws->SetHeader("Device-Id", SystemInfo::GetMacAddress().c_str());
+        ws->SetHeader("Client-Id", Board::GetInstance().GetUuid().c_str());
+        ws->OnData([&session_id, events](const char* data, size_t len, bool binary) {
+            if (binary) {
+                return;
+            }
+            cJSON* root = cJSON_ParseWithLength(data, len);
+            auto type = cJSON_GetObjectItem(root, "type");
+            if (cJSON_IsString(type) && strcmp(type->valuestring, "hello") == 0) {
+                auto id = cJSON_GetObjectItem(root, "session_id");
+                if (cJSON_IsString(id)) {
+                    session_id = id->valuestring;
+                }
+                xEventGroupSetBits(events, kHelloBit);
+            }
+            cJSON_Delete(root);
+        });
+        if (ws->Connect(job->url.c_str())) {
+            char hello[192];
+            snprintf(hello, sizeof(hello),
+                     "{\"type\":\"hello\",\"version\":%d,\"features\":{\"mcp\":true},"
+                     "\"transport\":\"websocket\",\"audio_params\":{\"format\":\"opus\","
+                     "\"sample_rate\":16000,\"channels\":1,\"frame_duration\":%d}}",
+                     job->version, OPUS_FRAME_DURATION_MS);
+            result = "no server hello";
+            if (ws->Send(hello) &&
+                (xEventGroupWaitBits(events, kHelloBit, pdFALSE, pdFALSE,
+                                     pdMS_TO_TICKS(kDeviceEventTimeoutMs)) & kHelloBit)) {
+                int expected = 0;
+                if (job->stage.compare_exchange_strong(expected, 1)) {
+                    std::string message = "{\"session_id\":\"" + session_id +
+                                          "\",\"type\":\"mcp\",\"payload\":" + job->payload + "}";
+                    sent = ws->Send(message);
+                    result = sent ? "own session" : "send failed";
+                    vTaskDelay(pdMS_TO_TICKS(kDeviceEventLingerMs));
+                } else {
+                    result = "abandoned";
+                }
+            }
+        }
+    }
+    ws.reset();
+    if (events) {
+        vEventGroupDelete(events);
+    }
+    Schedule([this, job, sent, result]() { FinishDeviceEvent(job, sent, result); });
+    event_worker_running_ = false;
+}
+
+void Application::FinishDeviceEvent(const std::shared_ptr<DeviceEventJob>& job, bool sent,
+                                    const char* reason) {
+    if (job != event_job_) {
+        if (sent) {
+            ESP_LOGW(TAG, "Device event sent after its timeout: %s", job->payload.c_str());
+        }
+        return;
+    }
+    esp_timer_stop(event_timeout_timer_);
+    auto done = std::move(event_done_);
+    event_done_ = nullptr;
+    event_job_.reset();
+    if (sent) {
+        ESP_LOGI(TAG, "Device event sent (%s): %s", reason, job->payload.c_str());
+    } else {
+        ESP_LOGW(TAG, "Device event not sent (%s): %s", reason, job->payload.c_str());
+    }
+    if (done) {
+        done(sent);
+    }
+}
