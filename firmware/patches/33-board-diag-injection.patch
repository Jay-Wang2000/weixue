+    // Handles a gesture as the IMU task does for a detector or tap-engine event.
+    bool DiagGesture(const std::string& name, std::string* result) {
+        for (int g = 0; g < kGestureCount; g++) {
+            if (name == kGestureNames[g]) {
+                ESP_LOGI(TAG, "IMU diag: injected %s", kGestureNames[g]);
+                OnGesture(static_cast<Gesture>(g));
+                *result = name;
+                return true;
+            }
+        }
+        *result = "gesture must be pick_up, face_down, face_up or double_tap";
+        return false;
+    }
+
+    bool DiagTouch(const std::vector<std::string>& args, std::string* result) {
+        const std::string action = args.empty() ? "" : args[0];
+        if (action == "tap" && args.size() == 3) {
+            char* end1 = nullptr;
+            char* end2 = nullptr;
+            long x = strtol(args[1].c_str(), &end1, 10);
+            long y = strtol(args[2].c_str(), &end2, 10);
+            if (*end1 != '\0' || *end2 != '\0' || !diag_pointer_.Tap(x, y)) {
+                *result = "tap needs x y within 0-465 (or the queue is full)";
+                return false;
+            }
+            *result = "tap " + args[1] + " " + args[2];
+            return true;
+        }
+        if (action == "swipe" && args.size() == 2) {
+            if (!diag_pointer_.Swipe(args[1])) {
+                *result = "swipe needs left, right, up or down (or the queue is full)";
+                return false;
+            }
+            *result = "swipe " + args[1];
+            return true;
+        }
+        if (action == "tour" && args.size() == 1) {
+            if (!diag_pointer_.Tour()) {
+                *result = "queue is full";
+                return false;
+            }
+            *result = "tour";
+            return true;
+        }
+        if (action == "press_boot" && args.size() == 1) {
+            ESP_LOGI(TAG, "Button diag: injected boot click");
+            OnBootClick();
+            *result = "press_boot";
+            return true;
+        }
+        *result = "touch needs tap <x> <y>, swipe <dir>, tour or press_boot";
+        return false;
+    }
+
+    std::string DiagStateJson() {
+        auto& app = Application::GetInstance();
+        std::string imu = imu_ != nullptr ? GetImuStateJson() : "null";
+        return std::string("{\"device_state\":\"") +
+               DeviceStateMachine::GetStateName(app.GetDeviceState()) + "\",\"panel_off\":" +
+               (panel_off_ ? "true" : "false") + ",\"brightness\":" +
+               std::to_string(backlight_->brightness()) + ",\"display\":" +
+               display_->DiagStateJson() + ",\"imu\":" + imu + "}";
+    }
+
+    // One line: `diag gesture <name>`, `diag touch tap <x> <y>` (or `diag tap <x> <y>`),
+    // `diag touch swipe <dir>` (or `diag swipe <dir>`), `diag touch press_boot` (or
+    // `diag press_boot`), `diag touch tour`, `diag dump`, `diag help`.
+    bool DiagCommand(const std::string& line, std::string* result) {
+        std::vector<std::string> args;
+        std::istringstream in(line);
+        for (std::string word; in >> word;) {
+            args.push_back(word);
+        }
+        if (args.size() < 2 || args[0] != "diag") {
+            *result = "unknown command; try diag help";
+            return false;
+        }
+        const std::string cmd = args[1];
+        std::vector<std::string> rest(args.begin() + 2, args.end());
+        if (cmd == "gesture" && rest.size() == 1) {
+            return DiagGesture(rest[0], result);
+        }
+        if (cmd == "touch") {
+            return DiagTouch(rest, result);
+        }
+        if (cmd == "tap" || cmd == "swipe" || cmd == "press_boot") {
+            rest.insert(rest.begin(), cmd);
+            return DiagTouch(rest, result);
+        }
+        if (cmd == "dump" && rest.empty()) {
+            *result = DiagStateJson();
+            display_->DiagRequestDump();
+            return true;
+        }
+        if (cmd == "help") {
+            *result = "diag gesture pick_up|face_down|face_up|double_tap; diag tap <x> <y>; "
+                      "diag swipe left|right|up|down; diag press_boot; diag touch tour; diag dump";
+            return true;
+        }
+        *result = "unknown command; try diag help";
+        return false;
+    }
+#endif
