+void Application::SendDeviceEvent(const std::string& payload, std::function<void(bool)> done) {
+    Schedule([this, payload, done = std::move(done)]() {
+        bool sent = false;
+        if (protocol_) {
+            if (!protocol_->IsAudioChannelOpened() && GetDeviceState() == kDeviceStateIdle &&
+                protocol_->OpenAudioChannel()) {
+                event_channel_ = true;
+                if (event_close_timer_ == nullptr) {
+                    const esp_timer_create_args_t args = {
+                        .callback = [](void* arg) {
+                            auto* app = static_cast<Application*>(arg);
+                            app->Schedule([app]() {
+                                if (app->event_channel_ && app->GetDeviceState() == kDeviceStateIdle &&
+                                    app->protocol_ && app->protocol_->IsAudioChannelOpened()) {
+                                    ESP_LOGI(TAG, "Closing the device event channel");
+                                    app->protocol_->CloseAudioChannel();
+                                }
+                            });
+                        },
+                        .arg = this,
+                        .dispatch_method = ESP_TIMER_TASK,
+                        .name = "event_close",
+                        .skip_unhandled_events = true,
+                    };
+                    esp_timer_create(&args, &event_close_timer_);
+                }
+                esp_timer_stop(event_close_timer_);
+                esp_timer_start_once(event_close_timer_, kDeviceEventLingerMs * 1000);
+            }
+            if (protocol_->IsAudioChannelOpened()) {
+                protocol_->SendMcpMessage(payload);
+                sent = true;
+            }
+        }
+        ESP_LOGI(TAG, "Device event %s: %s", sent ? "sent" : "not sent", payload.c_str());
+        if (done) {
+            done(sent);
+        }
+    });
+}
