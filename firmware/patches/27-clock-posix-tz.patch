+// Sets the UTC system clock from an HTTP Date header (see weixue_clock::ResyncFromDate).
+void Application::ResyncClock(const std::string& date) {
+    auto resync = weixue_clock::ResyncFromDate(getenv("TZ") != nullptr, date.c_str(), time(nullptr));
+    if (!resync.apply) {
+        return;
+    }
+    struct timeval tv = {.tv_sec = resync.server, .tv_usec = 0};
+    settimeofday(&tv, nullptr);
+    ESP_LOGI(TAG, "Clock: resynced from the backend Date header (was %+lld s)", resync.drift_s);
+}
